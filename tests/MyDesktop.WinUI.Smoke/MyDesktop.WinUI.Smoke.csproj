<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<ApplicationManifest>../../src/MyDesktop.WinUI/app.manifest</ApplicationManifest>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../../src/MyDesktop.Core/MyDesktop.Core.csproj" />
		<Compile Include="../../src/MyDesktop/Native/NativeMethods.cs" Link="NativeMethods.cs" />
		<Compile Include="../../src/MyDesktop/Native/ShellInterop.cs" Link="ShellInterop.cs" />
		<Compile Include="../../src/MyDesktop/Native/DesktopViewInterop.cs" Link="DesktopViewInterop.cs" />
		<Compile Include="../../src/MyDesktop/Native/ExplorerDesktopReader.cs" Link="ExplorerDesktopReader.cs" />
		<Compile Include="../../src/MyDesktop/Native/ExplorerDesktopWindow.cs" Link="ExplorerDesktopWindow.cs" />
		<Compile Include="../../src/MyDesktop/Native/FileClipboard.cs" Link="FileClipboard.cs" />
	</ItemGroup>
</Project>
