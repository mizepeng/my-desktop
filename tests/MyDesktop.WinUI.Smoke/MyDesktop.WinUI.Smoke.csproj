<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../../src/MyDesktop.Core/MyDesktop.Core.csproj" />
		<Compile Include="../../src/MyDesktop/Native/NativeMethods.cs" Link="NativeMethods.cs" />
	</ItemGroup>
</Project>
