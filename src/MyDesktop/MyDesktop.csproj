<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>MyDesktop</RootNamespace>
		<AssemblyName>MyDesktop</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<Product>MyDesktop 桌面分区</Product>
		<Description>Windows 11 桌面分区整理工具</Description>
		<Version>1.0.0</Version>
		<SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
		<!-- 枚举 switch 表达式漏掉分支时直接编译失败；未命名枚举值的提示无意义，关闭 -->
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524;WPF0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- WPF 项目的隐式 using 不含 System.IO（避免与 Shapes.Path 冲突），这里手动加回 -->
		<Using Include="System.IO" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
		<Resource Include="Assets\app.png" />
	</ItemGroup>

</Project>
