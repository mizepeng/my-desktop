<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>MyDesktop</RootNamespace>
		<AssemblyName>MyDesktop</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<!-- 自定义入口：右键菜单服务进程不加载 WPF -->
		<StartupObject>MyDesktop.Program</StartupObject>
		<Product>MyDesktop 桌面分区</Product>
		<Description>Windows 11 桌面分区整理工具</Description>
		<Version>1.0.6</Version>
		<SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
		<!-- 枚举 switch 表达式漏掉分支时直接编译失败；未命名枚举值的提示无意义，关闭 -->
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524;WPF0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- WPF 项目的隐式 using 不含 System.IO（避免与 Shapes.Path 冲突），这里手动加回 -->
		<Using Include="System.IO" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
		<Resource Include="Assets\app.png" />
		<!-- 发行版安装包签名证书的公钥，自动更新时用它核对下载的安装包 -->
		<EmbeddedResource Include="..\..\installer\MyDesktop.cer" LogicalName="MyDesktop.cer" />
	</ItemGroup>

	<!-- 生成并签名桌面右键菜单扩展包，放在 exe 旁边；没有签名证书时脚本只给出提示（导入方法见 ShellExtension\Pack-DesktopMenu.ps1）。
		 输入文件和版本号都没变时跳过：版本号记在 obj 里标记文件的文件名上，改了版本号就会重新生成，扩展包的版本跟着程序走 -->
	<Target Name="PackDesktopMenu" AfterTargets="Build"
			Inputs="ShellExtension\AppxManifest.xml;ShellExtension\Pack-DesktopMenu.ps1;Assets\app.png"
			Outputs="$(OutDir)MyDesktop.DesktopMenu.msix;$(IntermediateOutputPath)DesktopMenu-$(Version).stamp">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ShellExtension\Pack-DesktopMenu.ps1&quot; -OutFile &quot;$(OutDir)MyDesktop.DesktopMenu.msix&quot; -Version $(Version)"
				ContinueOnError="true" />
		<Touch Files="$(IntermediateOutputPath)DesktopMenu-$(Version).stamp" AlwaysCreate="true" />
	</Target>

	<Target Name="PublishDesktopMenu" AfterTargets="Publish" Condition="Exists('$(OutDir)MyDesktop.DesktopMenu.msix')">
		<Copy SourceFiles="$(OutDir)MyDesktop.DesktopMenu.msix" DestinationFolder="$(PublishDir)" />
	</Target>

</Project>
