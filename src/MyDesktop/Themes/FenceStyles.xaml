<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:MyDesktop.Views">

	<!-- 分区窗口专用样式，全部带 Key，避免影响设置窗口等其他界面 -->

	<Style x:Key="FenceScrollThumb" TargetType="Thumb">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Border CornerRadius="2" Background="{DynamicResource FenceSelectedBorder}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FenceScrollPageButton" TargetType="RepeatButton">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Background="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FenceScrollBar" TargetType="ScrollBar">
		<Setter Property="Width" Value="5" />
		<Setter Property="MinWidth" Value="5" />
		<!-- 右边距要让滚动条避开窗口右缘的缩放热区（5 DIP），否则拖滑块会变成调整窗口大小 -->
		<Setter Property="Margin" Value="0,2,5,2" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ScrollBar">
					<Track x:Name="PART_Track" IsDirectionReversed="True">
						<Track.DecreaseRepeatButton>
							<RepeatButton Style="{StaticResource FenceScrollPageButton}" Command="ScrollBar.PageUpCommand" />
						</Track.DecreaseRepeatButton>
						<Track.Thumb>
							<Thumb Style="{StaticResource FenceScrollThumb}" />
						</Track.Thumb>
						<Track.IncreaseRepeatButton>
							<RepeatButton Style="{StaticResource FenceScrollPageButton}" Command="ScrollBar.PageDownCommand" />
						</Track.IncreaseRepeatButton>
					</Track>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FenceListBox" TargetType="ListBox">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="4" />
		<Setter Property="SelectionMode" Value="Extended" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBox">
					<ScrollViewer Focusable="False"
							Background="Transparent"
							Padding="{TemplateBinding Padding}"
							HorizontalScrollBarVisibility="Disabled"
							VerticalScrollBarVisibility="Auto"
							CanContentScroll="False">
						<!-- 滚动条叠在内容上方、贴着右边，不像默认模板那样单独占一列：出现滚动条时图标区域不变窄（用户反馈）。
							 平时隐藏，鼠标移进分区窗口时淡入 -->
						<ScrollViewer.Template>
							<ControlTemplate TargetType="ScrollViewer">
								<Grid Background="{TemplateBinding Background}">
									<ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
											Margin="{TemplateBinding Padding}"
											CanContentScroll="{TemplateBinding CanContentScroll}" />
									<ScrollBar x:Name="PART_VerticalScrollBar"
											HorizontalAlignment="Right"
											Orientation="Vertical"
											Opacity="0"
											Maximum="{TemplateBinding ScrollableHeight}"
											ViewportSize="{TemplateBinding ViewportHeight}"
											Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
											Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
								</Grid>
								<ControlTemplate.Triggers>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
										<DataTrigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.ExitActions>
									</DataTrigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</ScrollViewer.Template>
						<ItemsPresenter />
					</ScrollViewer>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FenceItemContainer" TargetType="ListBoxItem">
		<Style.Triggers>
			<!-- 展开了完整名称的图标压在下面的图标之上 -->
			<DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
				<Setter Property="Panel.ZIndex" Value="1" />
			</DataTrigger>
		</Style.Triggers>
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Margin" Value="1" />
		<!-- 悬停、选中的底色按图标实际内容的大小画，不随同一行里最高的图标拉长 -->
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Padding" Value="3,5,3,4" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBoxItem">
					<Grid>
						<Border x:Name="Bd"
								CornerRadius="5"
								Background="Transparent"
								BorderBrush="Transparent"
								BorderThickness="1"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
						</Border>
						<!-- 选中时和系统桌面一样展开完整名称：整个格子连同选中底色往下延伸，盖在下面的图标上，不改变格子大小 -->
						<Canvas x:Name="Expanded" Visibility="Collapsed">
							<Border Width="{Binding ActualWidth, ElementName=Bd}"
									CornerRadius="5"
									BorderThickness="1"
									Padding="{TemplateBinding Padding}"
									Background="{DynamicResource FenceSelected}"
									ToolTip="{Binding ToolTipText}"
									ToolTipService.InitialShowDelay="700">
								<Grid>
									<StackPanel x:Name="ExpandedIconView">
										<Image x:Name="ExpandedIcon"
												Source="{Binding Icon}"
												Width="{DynamicResource IconSize}"
												Height="{DynamicResource IconSize}"
												Margin="0,0,0,4"
												Stretch="Uniform"
												RenderOptions.BitmapScalingMode="HighQuality" />
										<local:TextShadow Shadow="{DynamicResource TextShadow}">
											<TextBlock Text="{Binding DisplayName}"
													TextAlignment="Center"
													TextWrapping="Wrap"
													Foreground="{DynamicResource FenceForeground}" />
										</local:TextShadow>
									</StackPanel>
									<!-- 列表视图：和列表的一行（FenceWindow.xaml 的 ListTemplate）一样图标在左、名称离顶端 2，名称在右边折行 -->
									<DockPanel x:Name="ExpandedListView" Visibility="Collapsed">
										<Image x:Name="ExpandedListIcon"
												Source="{Binding Icon}"
												Width="20"
												Height="20"
												Margin="2,0,8,0"
												VerticalAlignment="Top"
												Stretch="Uniform"
												RenderOptions.BitmapScalingMode="HighQuality" />
										<local:TextShadow Shadow="{DynamicResource TextShadow}">
											<TextBlock Margin="{DynamicResource ListNameMargin}"
													Text="{Binding DisplayName}"
													TextWrapping="Wrap"
													Foreground="{DynamicResource FenceForeground}" />
										</local:TextShadow>
									</DockPanel>
								</Grid>
							</Border>
						</Canvas>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource FenceHover}" />
						</Trigger>
						<!-- 选中和悬停一样不带边框，底色略亮一点 -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource FenceSelected}" />
						</Trigger>
						<!-- 拖动的内容悬停在这个图标上，松手会交给它处理 -->
						<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource FenceSelected}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FenceSelectedBorder}" />
						</DataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsNameExpanded}" Value="True" />
								<Condition Binding="{Binding IsRenaming}" Value="False" />
							</MultiDataTrigger.Conditions>
							<Setter TargetName="Expanded" Property="Visibility" Value="Visible" />
							<Setter TargetName="Bd" Property="Visibility" Value="Hidden" />
						</MultiDataTrigger>
						<!-- 列表视图的容器样式把 Tag 设为 List -->
						<Trigger Property="Tag" Value="List">
							<Setter TargetName="ExpandedIconView" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ExpandedListView" Property="Visibility" Value="Visible" />
						</Trigger>
						<DataTrigger Binding="{Binding IsCut}" Value="True">
							<Setter TargetName="ExpandedIcon" Property="Opacity" Value="0.4" />
							<Setter TargetName="ExpandedListIcon" Property="Opacity" Value="0.4" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsHidden}" Value="True">
							<Setter TargetName="ExpandedIcon" Property="Opacity" Value="0.4" />
							<Setter TargetName="ExpandedListIcon" Property="Opacity" Value="0.4" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsInFlight}" Value="True">
							<Setter TargetName="Expanded" Property="Opacity" Value="0" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FenceListItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource FenceItemContainer}">
		<Setter Property="Margin" Value="0,0,0,1" />
		<Setter Property="Padding" Value="4,3" />
		<!-- 展开完整名称时按列表的一行排 -->
		<Setter Property="Tag" Value="List" />
	</Style>

	<Style x:Key="FenceTitleButton" TargetType="Button">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="22" />
		<Setter Property="Margin" Value="2,0,0,0" />
		<Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Foreground" Value="{DynamicResource FenceForeground}" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd" CornerRadius="4" Background="Transparent">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource FenceHover}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource FenceSelected}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RenameBoxStyle" TargetType="TextBox">
		<Setter Property="Background" Value="White" />
		<Setter Property="Foreground" Value="#FF1F1F1F" />
		<Setter Property="BorderBrush" Value="#FF3B82F6" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="1,0" />
		<Setter Property="AcceptsReturn" Value="False" />
		<Setter Property="SelectionBrush" Value="#FF3B82F6" />
	</Style>

</ResourceDictionary>
