<Window x:Class="MyDesktop.Views.DesktopLayerWindow"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:sys="clr-namespace:System;assembly=System.Runtime"
		xmlns:local="clr-namespace:MyDesktop.Views"
		Title="MyDesktop 桌面图标"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		ShowActivated="False"
		AllowDrop="True"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		FontSize="12">

	<Window.Resources>
		<!-- 以下尺寸按资源管理器的图标大小和间距在代码中更新 -->
		<sys:Double x:Key="IconSize">48</sys:Double>
		<sys:Double x:Key="CellWidth">76</sys:Double>
		<sys:Double x:Key="LabelWidth">66</sys:Double>
		<DropShadowEffect x:Key="TextShadow" ShadowDepth="1" BlurRadius="3" Opacity="0.85" Color="Black" Direction="270" />
		<!-- 几乎透明的底色让整个图标都能点中，图标之外的透明处点击仍穿透到系统桌面 -->
		<SolidColorBrush x:Key="CellBackground" Color="#01000000" />
		<SolidColorBrush x:Key="CellHover" Color="#2EFFFFFF" />
		<SolidColorBrush x:Key="CellHoverBorder" Color="#40FFFFFF" />
		<SolidColorBrush x:Key="CellSelected" Color="#5A9CCBF5" />
		<SolidColorBrush x:Key="CellSelectedBorder" Color="#99B4DCFF" />

		<Style x:Key="LayerItemContainer" TargetType="ListBoxItem">
			<Style.Triggers>
				<!-- 展开了完整名称的图标压在下面的图标之上 -->
				<DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
					<Setter Property="Panel.ZIndex" Value="1" />
				</DataTrigger>
			</Style.Triggers>
			<Setter Property="Canvas.Left" Value="{Binding X}" />
			<Setter Property="Canvas.Top" Value="{Binding Y}" />
			<Setter Property="Width" Value="{DynamicResource CellWidth}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<!-- 展开完整名称、改名框变高时窗口跟着调整范围 -->
			<EventSetter Event="SizeChanged" Handler="ItemContainer_SizeChanged" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bd"
								Margin="1,0"
								Padding="0,0,0,2"
								Background="{StaticResource CellBackground}"
								BorderBrush="Transparent"
								BorderThickness="1">
							<ContentPresenter HorizontalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource CellHover}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CellHoverBorder}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource CellSelected}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CellSelectedBorder}" />
							</Trigger>
							<!-- 拖动的内容悬停在这个图标上，松手会交给它处理 -->
							<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource CellSelected}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CellSelectedBorder}" />
							</DataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<DataTemplate x:Key="LayerItemTemplate" DataType="{x:Type local:FenceItem}">
			<StackPanel ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
				<Image x:Name="IconImage"
						Source="{Binding Icon}"
						Width="{DynamicResource IconSize}"
						Height="{DynamicResource IconSize}"
						Margin="0,0.33,0,1.67"
						Stretch="Uniform"
						RenderOptions.BitmapScalingMode="HighQuality" />
				<Grid Width="{DynamicResource LabelWidth}">
					<!-- 与系统桌面一样最多显示两行 -->
					<TextBlock x:Name="NameText"
							Text="{Binding DisplayName}"
							TextAlignment="Center"
							TextWrapping="Wrap"
							TextTrimming="CharacterEllipsis"
							LineStackingStrategy="BlockLineHeight"
							LineHeight="16"
							MaxHeight="32"
							Foreground="White"
							Effect="{StaticResource TextShadow}" />
					<TextBox x:Name="RenameBox"
							Visibility="Collapsed"
							Style="{StaticResource RenameBoxStyle}"
							TextAlignment="Center"
							TextWrapping="Wrap"
							Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
							KeyDown="RenameBox_KeyDown"
							LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
				</Grid>
			</StackPanel>
			<DataTemplate.Triggers>
				<!-- 和系统桌面一样，选中时展开完整名称 -->
				<DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
					<Setter TargetName="NameText" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsRenaming}" Value="True">
					<Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
					<Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
				</DataTrigger>
				<!-- 与资源管理器一样，剪切后的图标半透明 -->
				<DataTrigger Binding="{Binding IsCut}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.5" />
				</DataTrigger>
				<!-- 一键整理时已经起飞，原处不再显示；删除分区时正飞回桌面，落地前也不显示 -->
				<DataTrigger Binding="{Binding IsInFlight}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0" />
					<Setter TargetName="NameText" Property="Opacity" Value="0" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</Window.Resources>

	<Grid>
		<ListBox x:Name="ItemsList"
				Background="{x:Null}"
				BorderThickness="0"
				SelectionMode="Extended"
				FocusVisualStyle="{x:Null}"
				ItemContainerStyle="{StaticResource LayerItemContainer}"
				ItemTemplate="{StaticResource LayerItemTemplate}"
				PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
				PreviewMouseMove="ItemsList_PreviewMouseMove"
				PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
				MouseRightButtonUp="ItemsList_MouseRightButtonUp"
				SelectionChanged="ItemsList_SelectionChanged">
			<ListBox.Template>
				<ControlTemplate TargetType="ListBox">
					<ItemsPresenter />
				</ControlTemplate>
			</ListBox.Template>
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas />
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
		</ListBox>
	</Grid>
</Window>
