<Window x:Class="MyDesktop.Views.SearchWindow"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="搜索桌面图标"
		Width="672"
		SizeToContent="Height"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		Topmost="True"
		UseLayoutRounding="True"
		FontSize="14">

	<Window.Resources>
		<!-- 以下颜色按系统深浅色在代码里替换 -->
		<SolidColorBrush x:Key="SearchBackground" Color="#FA2B2B2B" />
		<SolidColorBrush x:Key="SearchBorder" Color="#33FFFFFF" />
		<SolidColorBrush x:Key="SearchForeground" Color="#FFFFFFFF" />
		<SolidColorBrush x:Key="SearchSecondary" Color="#99FFFFFF" />
		<SolidColorBrush x:Key="SearchHover" Color="#12FFFFFF" />
		<SolidColorBrush x:Key="SearchSelected" Color="#24FFFFFF" />

		<Style x:Key="ResultContainer" TargetType="ListBoxItem">
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bd" Margin="6,1" Padding="12,6" CornerRadius="6" Background="Transparent">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SearchHover}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SearchSelected}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<!-- 四周留出阴影的位置 -->
	<Border Margin="16" Background="{DynamicResource SearchBackground}" BorderBrush="{DynamicResource SearchBorder}" BorderThickness="1" CornerRadius="10">
		<Border.Effect>
			<DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.35" ShadowDepth="4" Color="Black" />
		</Border.Effect>
		<StackPanel>
			<Grid Height="56" Margin="18,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource SearchSecondary}" Text="&#xE721;" />
				<Grid Grid.Column="1" Margin="14,0,0,0">
					<TextBlock x:Name="Placeholder"
							VerticalAlignment="Center"
							FontSize="20"
							Foreground="{DynamicResource SearchSecondary}"
							IsHitTestVisible="False"
							Text="搜索桌面图标，可以用拼音或首字母" />
					<TextBox x:Name="QueryBox"
							VerticalAlignment="Center"
							Background="Transparent"
							BorderThickness="0"
							CaretBrush="{DynamicResource SearchForeground}"
							FocusVisualStyle="{x:Null}"
							FontSize="20"
							Foreground="{DynamicResource SearchForeground}"
							TextChanged="QueryBox_TextChanged" />
				</Grid>
			</Grid>
			<Border x:Name="ResultsPanel" BorderBrush="{DynamicResource SearchBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
				<StackPanel Margin="0,6">
					<TextBlock x:Name="FrequentHeader" Margin="18,4,18,4" FontSize="12" Foreground="{DynamicResource SearchSecondary}" Text="常用" Visibility="Collapsed" />
					<Grid>
						<ListBox x:Name="ResultsList"
								Background="Transparent"
								BorderThickness="0"
								Focusable="False"
								ItemContainerStyle="{StaticResource ResultContainer}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ScrollViewer.VerticalScrollBarVisibility="Disabled"
								PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Image Width="32" Height="32" Source="{Binding Item.Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
										<StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
											<TextBlock Foreground="{DynamicResource SearchForeground}" Text="{Binding Item.DisplayName}" TextTrimming="CharacterEllipsis" />
											<TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource SearchSecondary}" Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock x:Name="NoResultText" Margin="18,8" Foreground="{DynamicResource SearchSecondary}" Text="没有找到匹配的图标" Visibility="Collapsed" />
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>
	</Border>
</Window>
