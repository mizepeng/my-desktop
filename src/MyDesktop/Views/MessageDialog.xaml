<Window x:Class="MyDesktop.Views.MessageDialog"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		ThemeMode="System"
		Title="MyDesktop"
		Width="480"
		SizeToContent="Height"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen"
		Topmost="True"
		Icon="/Assets/app.ico">
	<Grid Margin="24,20,24,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="HeaderText" Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
		<!-- 说明最多显示 20 行，再长（如新版本的更新说明）就在这里滚动；屏幕矮时窗口另有限高（见构造函数），这里跟着变矮。
			Fluent 的滚动条（宽 12）叠在内容上：向右伸进边距 16、内容右边留出 16，文字排版不变，滚动条落在边距里不压字 -->
		<ScrollViewer Grid.Row="1" MaxHeight="420" Margin="0,0,-16,0" Padding="0,0,16,0" Focusable="False" VerticalScrollBarVisibility="Auto">
			<TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="21" />
		</ScrollViewer>
		<!-- 只在显示进度时出现 -->
		<ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="4" Margin="0,16,0,0" Maximum="1" Visibility="Collapsed" />
		<StackPanel x:Name="ButtonPanel" Grid.Row="3" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal" />
	</Grid>
</Window>
