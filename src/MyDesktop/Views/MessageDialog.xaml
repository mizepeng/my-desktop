<Window x:Class="MyDesktop.Views.MessageDialog"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		ThemeMode="System"
		Title="MyDesktop"
		Width="480"
		SizeToContent="Height"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen"
		Topmost="True"
		Icon="/Assets/app.ico">
	<Grid Margin="24,20,24,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="HeaderText" Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
		<TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" LineHeight="21" />
		<StackPanel x:Name="ButtonPanel" Grid.Row="2" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal" />
	</Grid>
</Window>
