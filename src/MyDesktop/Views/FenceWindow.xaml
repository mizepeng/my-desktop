<Window x:Class="MyDesktop.Views.FenceWindow"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:sys="clr-namespace:System;assembly=System.Runtime"
		xmlns:local="clr-namespace:MyDesktop.Views"
		xmlns:models="clr-namespace:MyDesktop.Models"
		Title="MyDesktop 分区"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="CanResize"
		ShowInTaskbar="False"
		ShowActivated="False"
		MinHeight="32"
		AllowDrop="True"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		FontSize="12">

	<Window.Resources>
		<sys:Double x:Key="IconSize">48</sys:Double>
		<sys:Double x:Key="CellWidth">92</sys:Double>
		<SolidColorBrush x:Key="FenceForeground" Color="White" />
		<SolidColorBrush x:Key="FenceHover" Color="#22FFFFFF" />
		<SolidColorBrush x:Key="FenceSelected" Color="#33FFFFFF" />
		<SolidColorBrush x:Key="FenceSelectedBorder" Color="#59FFFFFF" />
		<DropShadowEffect x:Key="TextShadow" ShadowDepth="1" BlurRadius="3" Opacity="0.75" Color="Black" />

		<Style TargetType="ScrollBar" BasedOn="{StaticResource FenceScrollBar}" />

		<ItemsPanelTemplate x:Key="IconsPanel">
			<WrapPanel Orientation="Horizontal" />
		</ItemsPanelTemplate>

		<ItemsPanelTemplate x:Key="ListPanel">
			<local:ListColumnsPanel />
		</ItemsPanelTemplate>

		<!-- 详细信息视图和资源管理器一样只排一列 -->
		<ItemsPanelTemplate x:Key="DetailsPanel">
			<StackPanel />
		</ItemsPanelTemplate>

		<!-- 详细信息视图后三列的宽度，按分区宽度在代码里设置，放不下的列宽度为 0 -->
		<GridLength x:Key="DetailsDateWidth">0</GridLength>
		<GridLength x:Key="DetailsTypeWidth">0</GridLength>
		<GridLength x:Key="DetailsSizeWidth">0</GridLength>

		<!-- 详细信息视图的表头格：悬停时有底色，点一下按这一列排序 -->
		<Style x:Key="DetailsHeaderCell" TargetType="Border">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="CornerRadius" Value="4" />
			<EventSetter Event="MouseLeftButtonUp" Handler="DetailsHeaderCell_MouseLeftButtonUp" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource FenceHover}" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="DetailsHeaderText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource FenceForeground}" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style x:Key="DetailsSortGlyph" TargetType="TextBlock">
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
			<Setter Property="FontSize" Value="8" />
			<Setter Property="Foreground" Value="{DynamicResource FenceForeground}" />
			<Setter Property="Opacity" Value="0.7" />
		</Style>
		<Style x:Key="DetailsInfoText" TargetType="TextBlock">
			<Setter Property="Margin" Value="12,2,0,0" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="Foreground" Value="{DynamicResource FenceForeground}" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="Effect" Value="{DynamicResource TextShadow}" />
		</Style>

		<!-- 图标视图里是否显示图标名称，按设置在代码里替换 -->
		<Visibility x:Key="IconNameVisibility">Visible</Visibility>

		<DataTemplate x:Key="IconTemplate" DataType="{x:Type local:FenceItem}">
			<StackPanel Width="{DynamicResource CellWidth}" ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
				<Image x:Name="IconImage"
						Source="{Binding Icon}"
						Width="{DynamicResource IconSize}"
						Height="{DynamicResource IconSize}"
						Margin="0,0,0,4"
						Stretch="Uniform"
						RenderOptions.BitmapScalingMode="HighQuality" />
				<Grid>
					<TextBlock x:Name="NameText"
							Visibility="{DynamicResource IconNameVisibility}"
							Text="{Binding DisplayName}"
							TextAlignment="Center"
							TextWrapping="Wrap"
							TextTrimming="CharacterEllipsis"
							MaxHeight="34"
							Foreground="{DynamicResource FenceForeground}"
							Effect="{DynamicResource TextShadow}" />
					<TextBox x:Name="RenameBox"
							Visibility="Collapsed"
							Style="{StaticResource RenameBoxStyle}"
							TextAlignment="Center"
							TextWrapping="Wrap"
							Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
							KeyDown="RenameBox_KeyDown"
							LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
				</Grid>
			</StackPanel>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsRenaming}" Value="True">
					<Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
					<Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
				</DataTrigger>
				<!-- 与资源管理器一样，剪切后的和隐藏的项目图标半透明；半透明的分区在开着自动颜色管理的显示器上显得偏亮，比资源管理器的 0.5 淡一些 -->
				<DataTrigger Binding="{Binding IsCut}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.4" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsHidden}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.4" />
				</DataTrigger>
				<!-- 一键整理时图标还在飞来的路上 -->
				<DataTrigger Binding="{Binding IsInFlight}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0" />
					<Setter TargetName="NameText" Property="Opacity" Value="0" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<DataTemplate x:Key="ListTemplate" DataType="{x:Type local:FenceItem}">
			<Grid ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Image x:Name="IconImage"
						Source="{Binding Icon}"
						Width="20"
						Height="20"
						Margin="2,0,8,0"
						VerticalAlignment="Top"
						Stretch="Uniform"
						RenderOptions.BitmapScalingMode="HighQuality" />
				<!-- 图标靠上、名称离顶端 2：12 号字在 20 高的图标旁大致居中，且与选中后展开完整名称（FenceStyles.xaml）的第一行位置一致，不会因布局取整差一个像素 -->
				<TextBlock x:Name="NameText"
						Grid.Column="1"
						Margin="0,2,0,0"
						VerticalAlignment="Top"
						Text="{Binding DisplayName}"
						TextTrimming="CharacterEllipsis"
						Foreground="{DynamicResource FenceForeground}"
						Effect="{DynamicResource TextShadow}" />
				<TextBox x:Name="RenameBox"
						Grid.Column="1"
						VerticalAlignment="Center"
						Visibility="Collapsed"
						Style="{StaticResource RenameBoxStyle}"
						Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
						KeyDown="RenameBox_KeyDown"
						LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
			</Grid>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsRenaming}" Value="True">
					<Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
					<Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
				</DataTrigger>
				<!-- 与资源管理器一样，剪切后的和隐藏的项目图标半透明；半透明的分区在开着自动颜色管理的显示器上显得偏亮，比资源管理器的 0.5 淡一些 -->
				<DataTrigger Binding="{Binding IsCut}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.4" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsHidden}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.4" />
				</DataTrigger>
				<!-- 一键整理时图标还在飞来的路上 -->
				<DataTrigger Binding="{Binding IsInFlight}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0" />
					<Setter TargetName="NameText" Property="Opacity" Value="0" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!-- 详细信息视图的一行：图标、名称和列表视图一样，后面是修改日期、类型、大小，列宽与表头（DetailsHeader）一致 -->
		<DataTemplate x:Key="DetailsTemplate" DataType="{x:Type local:FenceItem}">
			<Grid x:Name="Row" ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="{DynamicResource DetailsDateWidth}" />
					<ColumnDefinition Width="{DynamicResource DetailsTypeWidth}" />
					<ColumnDefinition Width="{DynamicResource DetailsSizeWidth}" />
				</Grid.ColumnDefinitions>
				<Image x:Name="IconImage"
						Source="{Binding Icon}"
						Width="20"
						Height="20"
						Margin="2,0,8,0"
						VerticalAlignment="Top"
						Stretch="Uniform"
						RenderOptions.BitmapScalingMode="HighQuality" />
				<TextBlock x:Name="NameText"
						Grid.Column="1"
						Margin="0,2,0,0"
						VerticalAlignment="Top"
						Text="{Binding DisplayName}"
						TextTrimming="CharacterEllipsis"
						Foreground="{DynamicResource FenceForeground}"
						Effect="{DynamicResource TextShadow}" />
				<TextBox x:Name="RenameBox"
						Grid.Column="1"
						VerticalAlignment="Center"
						Visibility="Collapsed"
						Style="{StaticResource RenameBoxStyle}"
						Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
						KeyDown="RenameBox_KeyDown"
						LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
				<TextBlock Grid.Column="2" Style="{StaticResource DetailsInfoText}" Text="{Binding ModifiedText}" />
				<TextBlock Grid.Column="3" Style="{StaticResource DetailsInfoText}" Text="{Binding TypeName}" />
				<TextBlock Grid.Column="4" Margin="12,2,4,0" Style="{StaticResource DetailsInfoText}" TextAlignment="Right" Text="{Binding SizeText}" />
			</Grid>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsRenaming}" Value="True">
					<Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
					<Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
				</DataTrigger>
				<!-- 与资源管理器一样，剪切后的和隐藏的项目图标半透明；半透明的分区在开着自动颜色管理的显示器上显得偏亮，比资源管理器的 0.5 淡一些 -->
				<DataTrigger Binding="{Binding IsCut}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.4" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsHidden}" Value="True">
					<Setter TargetName="IconImage" Property="Opacity" Value="0.4" />
				</DataTrigger>
				<!-- 一键整理时图标还在飞来的路上 -->
				<DataTrigger Binding="{Binding IsInFlight}" Value="True">
					<Setter TargetName="Row" Property="Opacity" Value="0" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</Window.Resources>

	<Grid>
		<!-- 毛玻璃：背景颜色下面铺一层模糊后的壁纸，画刷由代码设置 -->
		<Border x:Name="BlurLayer" CornerRadius="8" RenderOptions.BitmapScalingMode="Linear" />
		<Border x:Name="Frame" BorderThickness="1" CornerRadius="8" Background="#73000000" BorderBrush="#38FFFFFF">
			<!-- 卷起的分区标题栏放在收向的一侧，行列由代码按卷起方向重排 -->
			<Grid x:Name="LayoutRoot">
				<Grid.RowDefinitions>
					<RowDefinition Height="30" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border x:Name="TitleBar"
						Background="#30000000"
						CornerRadius="7,7,0,0"
						MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
						MouseMove="TitleBar_MouseMove"
						MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
						LostMouseCapture="TitleBar_LostMouseCapture"
						MouseRightButtonUp="TitleBar_MouseRightButtonUp"
						MouseWheel="TitleBar_MouseWheel">
					<Grid x:Name="TitleContent" Margin="10,0,4,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Orientation="Horizontal">
							<!-- 映射分区进入子文件夹后显示 -->
							<Button x:Name="BackButton"
									Margin="-6,0,4,0"
									Style="{StaticResource FenceTitleButton}"
									Content="&#xE72B;"
									ToolTip="返回上一级（Backspace）"
									Visibility="Collapsed"
									Click="BackButton_Click" />
							<!-- 映射分区：系统当前主题的文件夹图标；合并成标签页后改到各自的标签上 -->
							<Image x:Name="PortalIcon"
									Width="16"
									Height="16"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Visibility="Collapsed"
									RenderOptions.BitmapScalingMode="HighQuality" />
							<TextBlock x:Name="BadgeText"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
									FontSize="11"
									Opacity="0.8"
									Foreground="{DynamicResource FenceForeground}" />
						</StackPanel>
						<TextBlock x:Name="TitleText"
								Grid.Column="1"
								VerticalAlignment="Center"
								FontSize="13"
								FontWeight="SemiBold"
								TextTrimming="CharacterEllipsis"
								Foreground="{DynamicResource FenceForeground}"
								Effect="{DynamicResource TextShadow}" />
						<!-- 左右收起时的竖排标题：标题栏整体旋转 90°，这里再转回来，每个字一行、正立 -->
						<TextBlock x:Name="VerticalTitleText"
								Grid.Column="1"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Visibility="Collapsed"
								FontSize="13"
								FontWeight="SemiBold"
								TextAlignment="Center"
								Foreground="{DynamicResource FenceForeground}"
								Effect="{DynamicResource TextShadow}">
							<TextBlock.LayoutTransform>
								<RotateTransform Angle="-90" />
							</TextBlock.LayoutTransform>
						</TextBlock>
						<!-- 合并成标签页后，标题换成各成员分区的标签；竖放标题栏时标签文字竖排 -->
						<ItemsControl x:Name="TabStrip" Grid.Column="1" Visibility="Collapsed" Focusable="False">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<local:TabStripPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border x:Name="Tab" Margin="0,4,4,4" Padding="8,0" CornerRadius="5" Background="Transparent">
										<DockPanel>
											<!-- 映射分区的标签带上映射图标；整组共用的标题栏不再放映射角标，切换标签时标签不会左右跳 -->
											<Image x:Name="TabGlyph"
													Width="16"
													Height="16"
													Margin="0,0,5,0"
													VerticalAlignment="Center"
													Visibility="Collapsed"
													Opacity="0.6"
													Source="{Binding FolderIcon}"
													RenderOptions.BitmapScalingMode="HighQuality" />
											<Grid>
											<TextBlock x:Name="TabText"
													VerticalAlignment="Center"
													FontSize="13"
													FontWeight="SemiBold"
													Opacity="0.6"
													Text="{Binding Title}"
													TextTrimming="CharacterEllipsis"
													Foreground="{DynamicResource FenceForeground}"
													Effect="{DynamicResource TextShadow}" />
											<TextBlock x:Name="TabVerticalText"
													HorizontalAlignment="Left"
													VerticalAlignment="Center"
													Visibility="Collapsed"
													FontSize="13"
													FontWeight="SemiBold"
													Opacity="0.6"
													Text="{Binding VerticalTitle}"
													TextAlignment="Center"
													Foreground="{DynamicResource FenceForeground}"
													Effect="{DynamicResource TextShadow}">
												<TextBlock.LayoutTransform>
													<RotateTransform Angle="-90" />
												</TextBlock.LayoutTransform>
											</TextBlock>
											</Grid>
										</DockPanel>
									</Border>
									<DataTemplate.Triggers>
										<DataTrigger Binding="{Binding IsPortal}" Value="True">
											<Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
										</DataTrigger>
										<DataTrigger Binding="{Binding IsVertical}" Value="True">
											<Setter TargetName="Tab" Property="Margin" Value="0,3,4,3" />
											<Setter TargetName="Tab" Property="Padding" Value="6,0" />
											<Setter TargetName="TabText" Property="Visibility" Value="Collapsed" />
											<Setter TargetName="TabVerticalText" Property="Visibility" Value="Visible" />
											<!-- 竖放的标题栏整体转了 90°，图标转回来保持正立 -->
											<Setter TargetName="TabGlyph" Property="LayoutTransform">
												<Setter.Value>
													<RotateTransform Angle="-90" />
												</Setter.Value>
											</Setter>
										</DataTrigger>
										<Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
											<Setter TargetName="Tab" Property="Background" Value="{DynamicResource FenceHover}" />
										</Trigger>
										<DataTrigger Binding="{Binding IsActive}" Value="True">
											<Setter TargetName="Tab" Property="Background" Value="{DynamicResource FenceSelected}" />
											<Setter TargetName="TabText" Property="Opacity" Value="1" />
											<Setter TargetName="TabVerticalText" Property="Opacity" Value="1" />
											<Setter TargetName="TabGlyph" Property="Opacity" Value="1" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBox x:Name="TitleEditor"
								Grid.Column="1"
								Margin="0,0,4,0"
								VerticalAlignment="Center"
								Visibility="Collapsed"
								FontSize="13"
								Style="{StaticResource RenameBoxStyle}"
								KeyDown="TitleEditor_KeyDown"
								LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
						<StackPanel x:Name="TitleButtons" Grid.Column="2" Orientation="Horizontal" Opacity="0">
							<Button x:Name="RollButton" Style="{StaticResource FenceTitleButton}" Content="&#xE70E;" ToolTip="卷起" Click="RollButton_Click" />
							<Button x:Name="MenuButton" Style="{StaticResource FenceTitleButton}" Content="&#xE712;" ToolTip="分区菜单" Click="MenuButton_Click" />
						</StackPanel>
						<!-- 别的分区拖到这个标题栏上时的提示（只在横放的标题栏上显示文字） -->
						<Border x:Name="MergeHint"
								Grid.ColumnSpan="3"
								Margin="-6,3,0,3"
								CornerRadius="5"
								Background="#E63B82F6"
								IsHitTestVisible="False"
								Visibility="Collapsed">
							<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" Text="松手合并为标签页" />
						</Border>
					</Grid>
				</Border>

				<Grid x:Name="ContentHost" Grid.Row="1" ClipToBounds="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<!-- 详细信息视图的表头：和每一行一样宽（宽度由代码按列表可用宽度设置，不含滚动条），左右留出和选中框一样的边距 -->
					<Border x:Name="DetailsHeader"
							Margin="4,2,0,2"
							Padding="5,0"
							HorizontalAlignment="Left"
							BorderThickness="0,0,0,1"
							BorderBrush="{DynamicResource FenceHover}"
							Visibility="Collapsed">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="{DynamicResource DetailsDateWidth}" />
								<ColumnDefinition Width="{DynamicResource DetailsTypeWidth}" />
								<ColumnDefinition Width="{DynamicResource DetailsSizeWidth}" />
							</Grid.ColumnDefinitions>
							<Border Padding="2,3,4,4" Style="{StaticResource DetailsHeaderCell}" Tag="{x:Static models:SortField.Name}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource DetailsHeaderText}" Text="名称" />
									<TextBlock x:Name="NameSortGlyph" Style="{StaticResource DetailsSortGlyph}" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1" Padding="12,3,4,4" Style="{StaticResource DetailsHeaderCell}" Tag="{x:Static models:SortField.Modified}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource DetailsHeaderText}" Text="修改日期" />
									<TextBlock x:Name="ModifiedSortGlyph" Style="{StaticResource DetailsSortGlyph}" />
								</StackPanel>
							</Border>
							<Border Grid.Column="2" Padding="12,3,4,4" Style="{StaticResource DetailsHeaderCell}" Tag="{x:Static models:SortField.Type}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource DetailsHeaderText}" Text="类型" />
									<TextBlock x:Name="TypeSortGlyph" Style="{StaticResource DetailsSortGlyph}" />
								</StackPanel>
							</Border>
							<Border Grid.Column="3" Padding="12,3,4,4" Style="{StaticResource DetailsHeaderCell}" Tag="{x:Static models:SortField.Size}">
								<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
									<TextBlock x:Name="SizeSortGlyph" Margin="0,0,4,0" Style="{StaticResource DetailsSortGlyph}" />
									<TextBlock Style="{StaticResource DetailsHeaderText}" Text="大小" />
								</StackPanel>
							</Border>
						</Grid>
					</Border>
					<!-- 输入首字母按显示名定位图标 -->
					<ListBox x:Name="ItemsList"
							Grid.Row="1"
							TextSearch.TextPath="DisplayName"
							Style="{StaticResource FenceListBox}"
							ItemContainerStyle="{StaticResource FenceItemContainer}"
							PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
							PreviewMouseMove="ItemsList_PreviewMouseMove"
							PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
							PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
							MouseRightButtonUp="ItemsList_MouseRightButtonUp"
							SelectionChanged="ItemsList_SelectionChanged" />
					<TextBlock x:Name="EmptyHint"
							Grid.Row="1"
							Margin="12"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							TextAlignment="Center"
							TextWrapping="Wrap"
							Opacity="0.55"
							IsHitTestVisible="False"
							Text="拖放文件到这里"
							Foreground="{DynamicResource FenceForeground}" />
					<Canvas Grid.RowSpan="2" IsHitTestVisible="False">
						<!-- 拖动调整顺序时的插入位置 -->
						<Rectangle x:Name="InsertMarker"
								Visibility="Collapsed"
								RadiusX="1.5"
								RadiusY="1.5"
								Fill="#FF60A5FA" />
					</Canvas>
				</Grid>


				<!-- 调整大小时显示装得下的列数 × 行数，刚好装满时变成蓝色（代码里设置背景和数字颜色） -->
				<Border x:Name="GridHint"
						Grid.RowSpan="2"
						Grid.ColumnSpan="2"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Padding="14,4"
						CornerRadius="6"
						Visibility="Collapsed"
						IsHitTestVisible="False">
