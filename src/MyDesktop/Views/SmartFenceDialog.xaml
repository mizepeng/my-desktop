<Window x:Class="MyDesktop.Views.SmartFenceDialog"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		ThemeMode="System"
		Title="智能分区"
		Width="520"
		SizeToContent="Height"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen"
		Topmost="True"
		Icon="/Assets/app.ico">
	<Window.Resources>
		<Style x:Key="Label" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,12,0" />
		</Style>
		<Style x:Key="Hint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</Window.Resources>
	<StackPanel Margin="24,20,24,20">
		<TextBlock x:Name="HeaderText" Margin="0,0,0,4" FontSize="18" FontWeight="SemiBold" Text="新建智能分区" />
		<TextBlock Style="{StaticResource Hint}" Text="分区实时显示来源文件夹里符合下面全部条件的项目，只是显示，文件不移动。留空的条件不参与；只看来源文件夹这一层，文件夹按它自己的修改时间判断，设了扩展名或大小时不显示文件夹。" />
		<Grid Margin="0,16,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock Style="{StaticResource Label}" Text="分区名称" />
			<TextBox x:Name="TitleBox" Grid.Column="1" />

			<TextBlock Grid.Row="1" Margin="0,8,12,0" Style="{StaticResource Label}" Text="来源文件夹" />
			<DockPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
				<Button Margin="8,0,0,0" Content="浏览…" DockPanel.Dock="Right" Click="Browse_Click" />
				<TextBox x:Name="FolderBox" />
			</DockPanel>

			<TextBlock Grid.Row="2" Margin="0,8,12,0" Style="{StaticResource Label}" Text="修改时间" />
			<StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center" Text="最近" />
				<TextBox x:Name="DaysBox" Width="72" Margin="8,0" />
				<TextBlock VerticalAlignment="Center" Text="天以内（留空不限）" />
			</StackPanel>

			<TextBlock Grid.Row="3" Margin="0,8,12,0" Style="{StaticResource Label}" Text="扩展名" />
			<TextBox x:Name="ExtensionsBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" ToolTip="用分号分隔，例如 .zip; .7z；留空不限" />

			<TextBlock Grid.Row="4" Margin="0,8,12,0" Style="{StaticResource Label}" Text="名称" />
			<TextBox x:Name="NameBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" ToolTip="用分号分隔，带 * 或 ? 的是通配符（如 截图*），不带的是包含；留空不限" />

			<TextBlock Grid.Row="5" Margin="0,8,12,0" Style="{StaticResource Label}" Text="大小" />
			<StackPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center" Text="大于" />
				<TextBox x:Name="MinSizeBox" Width="80" Margin="8,0" />
				<TextBlock VerticalAlignment="Center" Text="MB，小于" />
				<TextBox x:Name="MaxSizeBox" Width="80" Margin="8,0" />
				<TextBlock VerticalAlignment="Center" Text="MB" />
			</StackPanel>
		</Grid>
		<CheckBox x:Name="FilterSubfoldersBox" Margin="0,12,0,0">
			<StackPanel>
				<TextBlock Text="进入子文件夹后也按这些条件筛选" />
				<TextBlock Style="{StaticResource Hint}" Text="关闭时，在分区里双击文件夹进入后显示里面的全部内容" />
			</StackPanel>
		</CheckBox>
		<TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
		<StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
			<Button x:Name="OkButton" MinWidth="96" Content="创建" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
			<Button MinWidth="96" Margin="8,0,0,0" Content="取消" IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>
