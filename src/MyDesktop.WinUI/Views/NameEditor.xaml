<UserControl
	x:Class="MyDesktop.WinUI.Views.NameEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Visibility="Collapsed">
	<Border Background="#F2232630" CornerRadius="8" Padding="12">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="8">
				<TextBlock x:Name="Caption" Foreground="White" />
				<TextBox x:Name="Input" KeyDown="Name_KeyDown" KeyUp="Name_KeyUp"
					TextCompositionStarted="Name_CompositionStarted" TextCompositionEnded="Name_CompositionEnded" />
				<TextBlock x:Name="Error" Foreground="#FFFFB4AB" TextWrapping="Wrap" />
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="确定" Click="Confirm_Click" />
					<Button Content="取消" Click="Cancel_Click" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Border>
</UserControl>
