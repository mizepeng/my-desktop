<UserControl
	x:Class="MyDesktop.WinUI.Views.FenceView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid x:Name="PanelRoot" RequestedTheme="Dark">
		<Border x:Name="Tint" />
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="36" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid x:Name="Header" Background="Transparent" Padding="8,0,4,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="4" />
				<Button x:Name="FoldButton" Grid.Column="1" Content="⌃" Click="Fold_Click" AllowFocusOnInteraction="False" ToolTipService.ToolTip="收起或展开" />
			</Grid>
			<Grid Grid.Row="1">
				<GridView x:Name="Items" SelectionMode="Extended" IsTabStop="False" Padding="6" DoubleTapped="Items_DoubleTapped" RightTapped="Items_RightTapped">
					<GridView.ItemTemplate>
						<DataTemplate>
							<StackPanel Width="88" Padding="4" Spacing="4" ToolTipService.ToolTip="{Binding Path}">
								<Image Source="{Binding Icon}" Width="48" Height="48" Stretch="Uniform" />
								<TextBlock Text="{Binding Name}" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</GridView.ItemTemplate>
				</GridView>
				<TextBlock x:Name="Status" Margin="12" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="White" />
			</Grid>
		</Grid>
		<Border x:Name="Editor" Visibility="Collapsed" Background="#F2232630" CornerRadius="8" Padding="12">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="8">
					<TextBlock x:Name="EditCaption" Foreground="White" />
					<TextBox x:Name="EditName" KeyDown="EditName_KeyDown" KeyUp="EditName_KeyUp"
						TextCompositionStarted="EditName_CompositionStarted" TextCompositionEnded="EditName_CompositionEnded" />
					<TextBlock x:Name="EditError" Foreground="#FFFFB4AB" TextWrapping="Wrap" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Content="确定" Click="EditConfirm_Click" />
						<Button Content="取消" Click="EditCancel_Click" />
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
