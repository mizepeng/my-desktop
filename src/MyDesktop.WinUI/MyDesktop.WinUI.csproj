<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
		<UseWinUI>true</UseWinUI>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>../MyDesktop/Assets/app.ico</ApplicationIcon>
		<Product>MyDesktop 桌面分区</Product>
		<Description>MyDesktop WinUI 3 桌面界面</Description>
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../MyDesktop.Core/MyDesktop.Core.csproj" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<Compile Include="../MyDesktop/Native/NativeMethods.cs" Link="Native/NativeMethods.cs" />
		<Compile Include="../MyDesktop/Native/ShellInterop.cs" Link="Native/ShellInterop.cs" />
		<Compile Include="../MyDesktop/Native/ShellFileOps.cs" Link="Native/ShellFileOps.cs" />
		<Compile Include="../MyDesktop/Native/FileClipboard.cs" Link="Native/FileClipboard.cs" />
		<Compile Include="../MyDesktop/Native/FileOperationInterop.cs" Link="Native/FileOperationInterop.cs" />
		<Compile Include="../MyDesktop/Native/ShellTransfer.cs" Link="Native/ShellTransfer.cs" />
		<Compile Include="../MyDesktop/Native/DesktopViewInterop.cs" Link="Native/DesktopViewInterop.cs" />
		<Compile Include="../MyDesktop/Native/ExplorerDesktopReader.cs" Link="Native/ExplorerDesktopReader.cs" />
		<Compile Include="../MyDesktop/Native/ExplorerDesktopWindow.cs" Link="Native/ExplorerDesktopWindow.cs" />
		<Compile Include="../MyDesktop/Core/ExplorerShell.cs" Link="Services/ExplorerShell.cs" />
		<Compile Include="../MyDesktop/Core/AppCommand.cs" Link="Services/AppCommand.cs" />
		<Compile Include="../../tests/MyDesktop.WinUI.Smoke/DesktopFixtureProtocol.cs" Link="Verification/DesktopFixtureProtocol.cs" />
		<RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="6291456" />
	</ItemGroup>
</Project>
