<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
		<UseWinUI>true</UseWinUI>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>../MyDesktop/Assets/app.ico</ApplicationIcon>
		<Product>MyDesktop 桌面分区</Product>
		<Description>MyDesktop WinUI 3 桌面界面</Description>
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../MyDesktop.Core/MyDesktop.Core.csproj" />
		<!-- 不引用 Microsoft.WindowsAppSDK 总包：它会带上 AI、机器学习（onnxruntime、DirectML）、搜索、小组件、DWriteCore 等用不到的组件，发布产物多出 50 MB 以上。
			 只引用用到的组件包，版本与总包 2.5.1 所含的一致 -->
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
		<PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
		<Compile Include="../MyDesktop/Native/NativeMethods.cs" Link="Native/NativeMethods.cs" />
		<Compile Include="../MyDesktop/Native/ShellInterop.cs" Link="Native/ShellInterop.cs" />
		<Compile Include="../MyDesktop/Native/ShellContextMenu.cs" Link="Native/ShellContextMenu.cs" />
		<Compile Include="../MyDesktop/Native/ShellFileOps.cs" Link="Native/ShellFileOps.cs" />
		<Compile Include="../MyDesktop/Native/FileClipboard.cs" Link="Native/FileClipboard.cs" />
		<Compile Include="../MyDesktop/Native/FileOperationInterop.cs" Link="Native/FileOperationInterop.cs" />
		<Compile Include="../MyDesktop/Native/ShellTransfer.cs" Link="Native/ShellTransfer.cs" />
		<Compile Include="../MyDesktop/Native/DesktopViewInterop.cs" Link="Native/DesktopViewInterop.cs" />
		<Compile Include="../MyDesktop/Native/ExplorerDesktopReader.cs" Link="Native/ExplorerDesktopReader.cs" />
		<Compile Include="../MyDesktop/Native/ExplorerDesktopWindow.cs" Link="Native/ExplorerDesktopWindow.cs" />
		<Compile Include="../MyDesktop/Core/ExplorerShell.cs" Link="Services/ExplorerShell.cs" />
		<Compile Include="../MyDesktop/Core/AppCommand.cs" Link="Services/AppCommand.cs" />
		<Compile Include="../MyDesktop/Core/SystemTheme.cs" Link="Services/SystemTheme.cs" />
		<Compile Include="../../tests/MyDesktop.WinUI.Smoke/DesktopFixtureProtocol.cs" Link="Verification/DesktopFixtureProtocol.cs" />
		<RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="6291456" />
	</ItemGroup>
	<!--
		界面只有中文：WinUI 包自带 80 多种语言的系统资源目录（如 de-DE\*.mui），发布时只留 zh-CN 和作为后备的 en-us。
		它们不是 .NET 卫星程序集，SatelliteResourceLanguages 管不到，只能按发布路径的首级目录过滤。
	-->
	<Target Name="TrimWinUILanguages" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<_OtherLanguageFile Include="@(ResolvedFileToPublish)"
					Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^[A-Za-z]{2,3}(-[A-Za-z0-9]+)+[\\/]'))
						And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '(?i)^(zh-CN|en-us)[\\/]'))" />
			<ResolvedFileToPublish Remove="@(_OtherLanguageFile)" />
		</ItemGroup>
	</Target>
	<!--
		非 MSIX 发布需要显式携带应用资源；SDK 的复制到编译目录规则不会自动进入 dotnet publish。
	-->
	<Target Name="PublishWinUIResources" AfterTargets="ComputeResolvedFilesToPublishList"
			DependsOnTargets="AddProcessedXamlFilesToCopyLocal;$(GenerateProjectPriFile)">
		<Error Condition="!Exists('$(ProjectPriFullPath)')" Text="WinUI 应用资源索引尚未生成，不能发布。" />
		<ItemGroup>
			<ResolvedFileToPublish Include="$(ProjectPriFullPath)">
				<RelativePath>$(ProjectPriFileName)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(_ProcessedXamlFilesToCopyLocalWithTargetPath)"
					Condition="'%(_ProcessedXamlFilesToCopyLocalWithTargetPath.Extension)' == '.xbf'">
				<RelativePath>%(_ProcessedXamlFilesToCopyLocalWithTargetPath.TargetPath)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>
</Project>
